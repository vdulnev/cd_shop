rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection - users can only read/write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Products collection - readable by anyone, writable only by admin
    match /products/{productId} {
      allow read: if true;
      // For admin writes, check if user has admin role in their profile
      allow write: if request.auth != null &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Carts collection - private to each user
    match /carts/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /items/{itemId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Addresses collection - private to each user
    match /addresses/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /items/{addressId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Orders collection - readable by owner, create-only for authenticated users
    match /orders/{orderId} {
      // Users can read their own orders
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;

      // Users can create orders for themselves
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;

      // Orders are immutable - no updates or deletes allowed by users
      // Status updates should be done via Cloud Functions
      allow update, delete: if false;
    }
  }
}
